<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#070B16"
    android:padding="18dp"
    android:layoutDirection="locale">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="הגדרת ווידג׳ט לו״ז"
        android:textColor="#E8EDF7"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/cfg_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="הקלידו קוד מועדון, טענו את הקבוצות, וסמנו את הקבוצות שיופיעו בווידג׳ט."
        android:textColor="#94A3B8"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/cfg_club"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:hint="קוד מועדון (למשל fcraanana)"
        android:textColorHint="#64748B"
        android:textColor="#E8EDF7"
        android:inputType="textNoSuggestions"
        android:textDirection="ltr"
        android:background="#0C1324"
        android:padding="12dp" />

    <Button
        android:id="@+id/cfg_load"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="טען קבוצות" />

    <TextView
        android:id="@+id/cfg_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#94A3B8"
        android:textSize="12sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp">

        <LinearLayout
            android:id="@+id/cfg_teams"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <Button
        android:id="@+id/cfg_save"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="שמירה והוספה" />
</LinearLayout>
